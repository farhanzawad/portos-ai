# ==========================================
# PORTOS AI — Environment Configuration Template
# ==========================================
# Copy this file to .env before starting the services:
#   cp .env.example .env
# Never commit real credentials or .env files to version control.

# Application Core Settings
APP_ENV=development
DEMO_MODE=true
APP_TIMEZONE=Asia/Dhaka
PORT=8000
HOST=0.0.0.0

# CORS & Frontend Origins
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database (PostgreSQL with PostGIS)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
POSTGRES_USER=portos
POSTGRES_PASSWORD=portos_dev_password
POSTGRES_DB=portos
DATABASE_URL=postgresql+psycopg://portos:portos_dev_password@localhost:5432/portos

# Google Gemini API (Optional in Demo Mode)
# Leave empty to run in local Demo Mode without external cloud calls
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Simulation & Deterministic Seeds
SIMULATION_SEED=42
SIMULATION_SPEED=1

# Map Provider (Optional; leave empty for fallback schematic style)
NEXT_PUBLIC_MAP_STYLE_URL=
MAP_ATTRIBUTION="© OpenStreetMap contributors"

